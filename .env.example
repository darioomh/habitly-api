# Supabase Configuration
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_KEY="your-supabase-service-role-key"

# JWT Secret (change in production!)
JWT_SECRET="your-secret-key-change-in-production"

# Google Sign-In (id_token validation)
GOOGLE_CLIENT_ID="604390654364-mj6srp32lvcfip7ur3jessavl0j7hbbh.apps.googleusercontent.com"

# Firebase Cloud Messaging (legacy server key)
FCM_SERVER_KEY="your-fcm-server-key"

# Admin operations (reset-monthly). Only enforced if set.
ADMIN_KEY=""

# Skip startup seeds/migrations on Vercel cold starts (1/true/yes)
SKIP_STARTUP_TASKS="false"

# Comma-separated allowed CORS origins (default: *)
# CORS_ORIGINS="https://app.habitly.com,http://localhost:3000"

# App Settings
APP_HOST=0.0.0.0
APP_PORT=8000
